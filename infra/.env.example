# Copy to .env (git-ignored) and load it before running tofu: `set -a; . ./.env; set +a`

# R2 > Overview > API Tokens > Manage: an Object Read & Write token on sauced-tfstate.
# Lets OpenTofu read and write its state.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# My Profile > API Tokens: Workers R2 Storage Edit, Hyperdrive Edit (account), and
# Zone Read + DNS Edit on hotsauced.app. Lets OpenTofu create the resources.
CLOUDFLARE_API_TOKEN=""
