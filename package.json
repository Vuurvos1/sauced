{
	"name": "sauced",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"db": "pnpm --filter @app/db -- ",
		"site": "pnpm --filter @app/site -- ",
		"scrapers": "pnpm --filter @app/scraper -- ",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"format": "oxfmt",
		"docker:up": "docker compose up -d",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"oxfmt": "^0.79.0",
		"turbo": "^2.11.11"
	},
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"overrides": {
			"vitest": "^5.0.3",
			"yaml@>=2.0.0 <2.8.3": "^2.8.3"
		},
		"patchedDependencies": {
			"@o7/icon@0.3.98": "patches/@o7__icon@0.3.98.patch"
		}
	}
}
