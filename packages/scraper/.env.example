DATABASE_URL="postgresql://postgres:password@localhost:5433/sauced"
CHROME_EXECUTABLE_PATH="/usr/bin/google-chrome" # "C:/Program Files/Google/Chrome/Application/chrome.exe"

# Image upload. These point at the local SeaweedFS bucket from docker-compose, which
# accepts any key. For R2, set R2_ACCOUNT_ID and drop R2_ENDPOINT. Empty skips uploads.
R2_ENDPOINT="http://localhost:8333"
R2_ACCOUNT_ID=""
R2_BUCKET="sauced-images"
R2_ACCESS_KEY_ID="local"
R2_SECRET_ACCESS_KEY="local"
