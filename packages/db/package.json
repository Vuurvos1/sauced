{
	"name": "@app/db",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"drizzle": "drizzle",
		"drizzle-kit": "drizzle-kit",
		"introspect": "drizzle-kit introspect:pg",
		"generate": "drizzle-kit generate",
		"diagram": "node dbml.js && pnpm dbml-renderer -i schema.dbml -o erd.svg",
		"studio": "dotenv -e .env -- drizzle-kit studio",
		"migrate": "drizzle-kit migrate"
	},
	"type": "module",
	"exports": {
		".": "./index.js",
		"./schema": "./schema/index.js",
		"./types": "./types.ts"
	},
	"peerDependencies": {
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:"
	},
	"dependencies": {
		"dotenv": "^16.6.1",
		"postgres": "catalog:"
	},
	"devDependencies": {
		"@softwaretechnik/dbml-renderer": "^1.0.31",
		"dotenv-cli": "^7.4.4",
		"drizzle-dbml-generator": "^0.10.0",
		"drizzle-kit": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:"
	}
}
