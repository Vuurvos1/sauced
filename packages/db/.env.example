DATABASE_URL="postgresql://postgres:password@localhost:5433/sauced"

# `pnpm db pull`: copy this database's catalogue (not users) into DATABASE_URL.
# Use a read-only role. Photos come from PULL_IMAGE_BASE_URL into the local bucket.
PULL_DATABASE_URL=""
PULL_IMAGE_BASE_URL="https://img.hotsauced.app"
R2_ENDPOINT="http://localhost:8333"
R2_BUCKET="sauced-images"
R2_ACCESS_KEY_ID="local"
R2_SECRET_ACCESS_KEY="local"
