# Image bucket: the local SeaweedFS one, or https://img.hotsauced.app.
# Empty shows the shops' own image URLs.
PUBLIC_IMAGE_BASE_URL="http://localhost:8333/sauced-images"

# Admin photo editor uploads. These point at the local SeaweedFS bucket.
R2_ENDPOINT="http://localhost:8333"
R2_BUCKET="sauced-images"
R2_ACCESS_KEY_ID="local"
R2_SECRET_ACCESS_KEY="local"
