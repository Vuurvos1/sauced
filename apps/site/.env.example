DATABASE_URL="postgresql://postgres:password@localhost:5433/sauced"
BETTER_AUTH_SECRET="" # openssl rand -base64 32

RESEND_API_KEY=""

# Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Review moderation through Workers AI's REST API. These point at the local stand-in
# from docker-compose.yaml, which flags a few test words. For the real model, set
# your account id, an API token with Workers AI permission, and drop the base URL.
# Leave them all empty to save reviews unmoderated.
CLOUDFLARE_ACCOUNT_ID="local"
CLOUDFLARE_AI_TOKEN="local"
CLOUDFLARE_API_BASE_URL="http://localhost:8788/client/v4"
