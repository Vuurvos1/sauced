{
	"name": "@app/site",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "pnpm test:integration && pnpm test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check . && eslint .",
		"format": "oxfmt .",
		"test:integration": "docker compose -f ../../docker-compose.yaml up -d db-test && playwright test",
		"test:unit": "vitest",
		"generate:auth": "pnpm dlx @better-auth/cli@latest generate --config ./src/lib/server/auth.ts --output ../../packages/db/schema/auth.js"
	},
	"devDependencies": {
		"@app/boring-avatars": "workspace:^",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"@softwaretechnik/dbml-renderer": "^1.0.31",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-cloudflare": "^4.9.0",
		"@sveltejs/adapter-cloudflare-workers": "^2.9.0",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@types/eslint": "^9.6.1",
		"@types/pg": "^8.23.1",
		"autoprefixer": "^10.6.1",
		"drizzle-kit": "catalog:",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"postcss": "^8.5.28",
		"svelte": "^5.57.1",
		"svelte-check": "^3.8.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^5.4.21",
		"vitest": "^3.2.7",
		"zod": "4.6.5"
	},
	"type": "module",
	"dependencies": {
		"@app/db": "workspace:^",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
