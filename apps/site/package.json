{
	"name": "@app/site",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "pnpm test:integration && pnpm test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check . && eslint .",
		"format": "oxfmt .",
		"test:integration": "docker compose -f ../../docker-compose.yaml up -d db-test && playwright test",
		"test:unit": "vitest",
		"generate:auth": "pnpm dlx @better-auth/cli@latest generate --config ./src/lib/server/auth.ts --output ../../packages/db/schema/auth.js"
	},
	"devDependencies": {
		"@app/boring-avatars": "workspace:^",
		"@electric-sql/pglite": "catalog:",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.65.1",
		"@softwaretechnik/dbml-renderer": "^1.0.31",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-vercel": "^7.0.4",
		"@sveltejs/kit": "^3.3.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"autoprefixer": "^10.6.2",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"postcss": "^8.5.33",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.164.0",
		"zod": "4.6.7"
	},
	"type": "module",
	"dependencies": {
		"@app/db": "workspace:^",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
		"@o7/icon": "^0.3.98",
		"@tensorflow-models/toxicity": "^1.2.2",
		"@tensorflow/tfjs": "^4.22.0",
		"better-auth": "^1.7.25",
		"bits-ui": "^1.8.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:",
		"postgres": "catalog:",
		"resend": "^4.8.0",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^2.6.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
